PORT=3000
NODE_ENV=development
DB_HOST=localhost
DB_PORT=3306
DB_NAME=esports_api
DB_USER=root
DB_PASSWORD=tu_contraseña_mysql

# Cuenta Admin inicial (se crea automáticamente si no existe; cambia estos valores)
ADMIN_NAME=Administrador
ADMIN_EMAIL=admin@esports.local
ADMIN_PASSWORD=Cambia_Esta_Clave_123!
JWT_SECRET=REEMPLAZA_POR_UN_SECRETO_ALEATORIO_DE_AL_MENOS_32_CARACTERES
JWT_EXPIRES_IN=1h
JWT_COOKIE_MAX_AGE=3600000

# Orígenes permitidos separados por coma. Para servir el frontend desde la misma API, deja localhost:3000.
CLIENT_URL=http://localhost:3000

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/v1/auth/google/callback
FRONTEND_URL=http://localhost:5173
